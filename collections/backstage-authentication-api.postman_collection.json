                  ],
                  "path": [
                    ":provider",
                    "refresh"
                  ],
                  "query": [
                    {
                      "description": "If set, the refresh will not fail if no refresh token is available but will return an empty response instead.",
                      "key": "optional",
                      "value": "<boolean>"
