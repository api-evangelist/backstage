    {
      "name": "frame",
      "item": [
        {
          "name": "handler",
          "item": [
            {
              "name": "Handles the response from the consent popup for the provider",
              "id": "a7c06fc6-48e0-4c1b-81e1-905996ce1a32",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/frame/handler?scope=<string>&code=<string>&state=<string>&env=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "frame",
                    "handler"
                  ],
                  "query": [
                    {
                      "description": "(Required) Scope requested for the auth session",
                      "key": "scope",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Short-term authorization code used to be exchanged for access tokens",
                      "key": "code",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Nonce value stored in state",
                      "key": "state",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Parameter to indicate runtime environment",
                      "key": "env",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "If the login request is accepted, the popup window will be redirected back to the `/handler/frame` endpoint of the auth backend."
              },
